{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "mio",
  "description": "MiMo-exclusive desktop AI coding agent",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev:desktop": "bun --cwd packages/shell dev",
    "dev:runtime": "bun --cwd packages/runtime dev",
    "lint": "oxlint",
    "typecheck": "bun turbo typecheck",
    "prepare": "husky",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/node": "24.12.2",
      "@tsconfig/node22": "22.0.2",
      "typescript": "5.8.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1"
    }
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "glob": "13.0.5",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "turbo": "2.8.13"
  },
  "dependencies": {
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shin4/mio"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "electron"
  ]
}
