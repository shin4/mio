{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": [
    "CI"
  ],
  "globalPassThroughEnv": [
    "CI"
  ],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": [
        "lib/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "outputs": []
    },
    "test:ci": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "outputs": [],
      "passThroughEnv": [
        "*"
      ]
    }
  }
}
