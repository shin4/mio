{
  "name": "@mio/asr",
  "version": "0.1.7-rc.2",
  "private": true,
  "description": "MiMo ASR as a cloud provider for the official dsh voice input",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-experimental-speech-to-text": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
