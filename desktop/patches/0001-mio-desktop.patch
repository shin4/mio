+/**
+ * Mio: presets kept registered but never offered. Sessions recorded under them still resume, and
+ * the Host resets a saved default among them, so only the choosing surfaces drop them.
+ */
+const HIDDEN_PRESETS: ReadonlySet<string> = new Set(['ptc', 'minimal'])
+
+/**
+ * Drop the presets Mio does not offer from a roster.
+ * @param roster - the Host roster.
+ * @returns the roster the choosing surfaces show.
+ */
+export function offeredRoster(roster: AgentPresetRoster): AgentPresetRoster {
+  return { ...roster, presets: roster.presets.filter(preset => !HIDDEN_PRESETS.has(preset.id)) }
+}
