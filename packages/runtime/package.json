{
  "name": "@mio/runtime",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Mio agent runtime composed on DeepSeek Harness (dsh) \u2014 MiMo served by dsh's own pi-ai adapter",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "DSH_HOME=${DSH_HOME:-$PWD/.dsh} dsh web --patch ./mio.patch.yml",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "test:ci": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "@mio/client-ui": "workspace:*"
  }
}
