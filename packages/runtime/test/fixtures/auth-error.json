{
  "version": 1,
  "metadata": {
    "name": "mimo/auth-error",
    "tags": [
      "provider:mimo",
      "protocol:openai-chat",
      "error"
    ]
  },
  "interactions": [
    {
      "transport": "http",
      "request": {
        "method": "POST",
        "url": "https://token-plan-cn.xiaomimimo.com/v1/chat/completions",
        "headers": {
          "content-type": "application/json"
        },
        "body": "{\"model\":\"mimo-v2.5\",\"stream\":true,\"stream_options\":{\"include_usage\":true},\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":16}"
      },
      "response": {
        "status": 401,
        "headers": {
          "content-type": "application/json"
        },
        "body": "{\n    \"error\": {\n        \"message\": \"Invalid API Key\",\n        \"param\": \"Please provide valid API Key\",\n        \"code\": \"401\",\n        \"type\": \"invalid_key\"\n    }\n}\n"
      }
    }
  ]
}
