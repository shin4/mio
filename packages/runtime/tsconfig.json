{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // Node type-stripping runs these files as-is: erasable syntax only
    // (no enums, namespaces, or parameter properties).
    "erasableSyntaxOnly": true
  },
  "include": ["test"]
}
