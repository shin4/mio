{
  "name": "@mio/llm-mimo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "MiMo model-provider plugin for DeepSeek Harness \u2014 endpoints, auth, request shaping, tool-call repair",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
