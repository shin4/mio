{
  "extends": "./tsconfig.json",
  "include": ["src"],
  "compilerOptions": {
    "noEmit": false,
    "outDir": "lib",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Source imports use `./x.ts`; emit rewrites them to `./x.js` (same pattern
    // dsh's own packages ship).
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  }
}
