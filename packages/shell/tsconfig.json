{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true
  },
  // The packaging config carries real logic (DMG notarization), so it is
  // typechecked with the source. `scripts/` stays out: it is Bun-only.
  "include": ["src", "electron-builder.config.ts"]
}
